{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTR context record",
  "type": "object",
  "required": [
    "id",
    "kind",
    "layer",
    "status",
    "title",
    "body",
    "sources",
    "actor",
    "tags",
    "read_when",
    "relations",
    "ttl_days",
    "updated_at",
    "review_after",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "kind": {
      "enum": [
        "experience",
        "wound",
        "hypothesis",
        "decision",
        "experiment",
        "evaluation",
        "memory",
        "rule"
      ]
    },
    "layer": {
      "enum": [
        "rules",
        "current",
        "decisions",
        "evidence",
        "relations",
        "residues"
      ]
    },
    "status": {
      "enum": [
        "active",
        "proposed",
        "accepted",
        "rejected",
        "unresolved",
        "investigating",
        "scarred",
        "recurring",
        "composted",
        "superseded"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "assistant",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "read_when": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "addresses",
              "supports",
              "contradicts",
              "supersedes",
              "depends_on",
              "derived_from"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_after": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  }
}
