{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTR experiment plan",
  "type": "object",
  "required": [
    "kind",
    "title",
    "acceptance",
    "wounds",
    "variants"
  ],
  "properties": {
    "hypothesis": {"type": "string"},
    "kind": {
      "enum": [
        "counterfactual",
        "forgetting"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "string",
      "minLength": 1
    },
    "wounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "suite": {
      "type": "string"
    },
    "required_pass": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "ref"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "omit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edits": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
