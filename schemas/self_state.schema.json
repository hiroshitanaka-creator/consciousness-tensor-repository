    "repo_tree_hash": { "type": "string" },
    "current_goal_hash": { "type": "string" },
    "memory_digest": { "type": "string" },
    "active_wounds": { "type": "array", "items": { "type": "string" } },
    "deleted_self_claims": { "type": "array", "items": { "type": "string" } },
    "irreversible_decisions": { "type": "array", "items": { "type": "string" } },
    "relation_graph_hash": { "type": "string" },
    "shadow_seed_hash": { "type": "string" },
    "bias_manifest_hash": { "type": "string" },
    "trace_ledger_hash": { "type": "string" }
